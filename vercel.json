{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/posts/:slug.html",
      "has": [
        {
          "type": "host",
          "value": "bloomandbudget.vercel.app"
        }
      ],
      "destination": "https://www.bloomandbudget.blog/posts/:slug",
      "statusCode": 301
    },
    {
      "source": "/:page.html",
      "has": [
        {
          "type": "host",
          "value": "bloomandbudget.vercel.app"
        }
      ],
      "destination": "https://www.bloomandbudget.blog/:page",
      "statusCode": 301
    },
    {
      "source": "/posts/simple-skincare-routine-glowing-skin.html",
      "destination": "/posts/budget-first-salary",
      "statusCode": 301
    },
    {
      "source": "/posts/simple-skincare-routine-glowing-skin",
      "destination": "/posts/budget-first-salary",
      "statusCode": 301
    },
    {
      "source": "/posts/small-bedroom-organization-ideas.html",
      "destination": "/posts/money-mistakes",
      "statusCode": 301
    },
    {
      "source": "/posts/small-bedroom-organization-ideas",
      "destination": "/posts/money-mistakes",
      "statusCode": 301
    },
    {
      "source": "/life.html",
      "destination": "/career",
      "statusCode": 301
    },
    {
      "source": "/life",
      "destination": "/career",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "statusCode": 301
    },
    {
      "source": "/disclaimer.html",
      "destination": "/disclaimer",
      "statusCode": 301
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "statusCode": 301
    },
    {
      "source": "/free-budget-template.html",
      "destination": "/free-budget-template",
      "statusCode": 301
    },
    {
      "source": "/budgeting.html",
      "destination": "/budgeting",
      "statusCode": 301
    },
    {
      "source": "/saving.html",
      "destination": "/saving",
      "statusCode": 301
    },
    {
      "source": "/mistakes.html",
      "destination": "/mistakes",
      "statusCode": 301
    },
    {
      "source": "/posts/:slug.html",
      "destination": "/posts/:slug",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bloomandbudget.vercel.app"
        }
      ],
      "destination": "https://www.bloomandbudget.blog/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://www.google.com https://www.gstatic.com https://adservice.google.com https://securepubads.g.doubleclick.net https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://*.googlesyndication.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://*.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog/BingSiteAuth.xml",
      "destination": "/BingSiteAuth.xml"
    },
    {
      "source": "/blog/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/blog/robots.txt",
      "destination": "/robots.txt"
    }
  ]
}